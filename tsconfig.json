{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    // Environment
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "types": [
      "jest",
      "node"
    ],
    // Type Checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Modules
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // Output
    "sourceMap": false,
    "declarationMap": false,
    "declaration": false,
    "removeComments": true,
    "noEmitOnError": true,
    // Other
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}