    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "pino": "^10.4.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
